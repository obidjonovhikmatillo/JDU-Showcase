# =============================================================================
# TasteGuide — Environment variables
# Copy to `.env` for local development. Set the same keys in Vercel → Settings → Environment Variables.
# Never commit `.env` or real secrets.
# =============================================================================

# --- App URL (required in production) ----------------------------------------
# Public site URL, no trailing slash. Used for Auth.js, Open Graph, and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PostgreSQL (required) -----------------------------------------------------
# Local Docker/Postgres example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cowork_restaurants?schema=public"
# Direct connection for Prisma migrations (same as DATABASE_URL locally).
# Neon: use the *non-pooled* connection string here.
# Supabase: use "Session mode" or direct connection (port 5432).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cowork_restaurants?schema=public"

# Neon example (pooled app + direct migrate):
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Supabase example:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Auth.js (required) ------------------------------------------------------
# Generate: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Must match NEXT_PUBLIC_APP_URL in production (https://your-domain.vercel.app)
AUTH_URL=http://localhost:3000

# --- Vercel Blob (production uploads) ----------------------------------------
# Production on Vercel: link a Blob store — OIDC auth uses BLOB_STORE_ID automatically.
# Local development fallback (optional): set BLOB_READ_WRITE_TOKEN from Vercel → Storage → Blob.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# --- Production seed guard (never set on Vercel) -------------------------------
# Only use when intentionally seeding a production DB from your machine:
# ALLOW_PRODUCTION_SEED=true

# --- Optional: Playwright / scripts --------------------------------------------
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# TEST_LOCALE=en

# --- Vercel (auto-injected, do not set manually) -----------------------------
# VERCEL_URL=your-app.vercel.app

# --- Notes -------------------------------------------------------------------
# Locales: en | uz | ru | ja (next-intl, no env var required)
# Maps: address text fallback only (Leaflet not bundled yet)
# Local uploads: public/uploads/ works in development only; use Vercel Blob in production
