generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Language {
  UZ
  EN
  RU
  JA
}

model User {
  id                String   @id @default(cuid())
  fullName          String
  email             String   @unique
  passwordHash      String
  role              Role     @default(USER)
  preferredLanguage Language @default(EN)
  avatarUrl         String?
  profileHeadline   String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  comments     Comment[]
  projects     Project[]     @relation("ProjectAuthor")
  likes        ProjectLike[]
  saves        ProjectSave[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  nameUz    String
  nameEn    String
  nameRu    String
  nameJa    String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@index([slug])
  @@map("categories")
}

model Project {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  descriptionUz String   @db.Text
  descriptionEn String   @db.Text
  descriptionRu String   @db.Text
  descriptionJa String   @db.Text
  authorName    String
  department    String
  techStack     String?
  demoUrl       String?
  githubUrl     String?
  mainImageUrl  String?
  mainImagePublicId String?
  difficulty    String?
  isPublished   Boolean  @default(false)
  categoryId    String
  authorId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author   User?           @relation("ProjectAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  images   ProjectImage[]
  comments Comment[]
  likes    ProjectLike[]
  saves    ProjectSave[]

  @@index([title])
  @@index([department])
  @@index([slug])
  @@index([categoryId])
  @@index([isPublished])
  @@index([techStack])
  @@index([department, isPublished])
  @@index([categoryId, isPublished])
  @@index([title, department])
  @@index([authorId])
  @@map("projects")
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  imageUrl  String
  publicId  String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_images")
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  projectId String
  rating    Int
  title     String
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  images  CommentImage[]

  @@index([userId])
  @@index([projectId])
  @@index([rating])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([projectId, rating])
  @@map("comments")
}

model CommentImage {
  id        String   @id @default(cuid())
  commentId String
  imageUrl  String
  publicId  String?
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("comment_images")
}

model ProjectLike {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
  @@map("project_likes")
}

model ProjectSave {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
  @@map("project_saves")
}
