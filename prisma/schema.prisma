generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Language {
  UZ
  EN
  RU
  JA
}

model User {
  id                String   @id @default(cuid())
  fullName          String
  email             String   @unique
  passwordHash      String
  role              Role     @default(USER)
  preferredLanguage Language @default(EN)
  avatarUrl         String?
  profileHeadline   String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reviews Review[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  nameUz    String
  nameEn    String
  nameRu    String
  nameJa    String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants Restaurant[]

  @@index([slug])
  @@map("categories")
}

model Restaurant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  descriptionUz String   @db.Text
  descriptionEn String   @db.Text
  descriptionRu String   @db.Text
  descriptionJa String   @db.Text
  address       String
  city          String
  phone         String?
  website       String?
  openingHours  String?
  latitude      Float
  longitude     Float
  mainImageUrl  String?
  mainImagePublicId String?
  priceLevel    Int?
  cuisineType   String?
  isPublished   Boolean  @default(false)
  categoryId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   RestaurantImage[]
  reviews  Review[]

  @@index([name])
  @@index([city])
  @@index([slug])
  @@index([categoryId])
  @@index([isPublished])
  @@index([cuisineType])
  @@index([city, isPublished])
  @@index([categoryId, isPublished])
  @@index([name, city])
  @@map("restaurants")
}

model RestaurantImage {
  id           String   @id @default(cuid())
  restaurantId String
  imageUrl     String
  publicId     String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("restaurant_images")
}

/// rating is validated in application code (integer 1–5)
model Review {
  id           String    @id @default(cuid())
  userId       String
  restaurantId String
  rating       Int
  title        String
  content      String    @db.Text
  visitDate    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  images     ReviewImage[]

  @@index([userId])
  @@index([restaurantId])
  @@index([rating])
  @@index([userId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, rating])
  @@map("reviews")
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  imageUrl  String
  publicId  String?
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}
